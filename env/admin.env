# SPDX-License-Identifier: Apache-2.0
FUNCTION_NAME=admin-service
NODE_ENV=dev
MAX_CPU=1
# FASTIFY
PORT=3100
HOST='0.0.0.0'
ENABLE_FRMS_DATABASES=true
# DATABASE
CONFIGURATION_DATABASE_PORT=5432
#CONFIGURATION_DATABASE_CERT_PATH=''
CONFIGURATION_DATABASE=configuration
CONFIGURATION_DATABASE_USER=postgres
CONFIGURATION_DATABASE_PASSWORD=unused
CONFIGURATION_DATABASE_HOST=tazama-postgres-1

EVENT_HISTORY_DATABASE_PORT=5432
EVENT_HISTORY_DATABASE=event_history
#EVENT_HISTORY_DATABASE_CERT_PATH=''
EVENT_HISTORY_DATABASE_USER=postgres
EVENT_HISTORY_DATABASE_PASSWORD=unused
EVENT_HISTORY_DATABASE_HOST=tazama-postgres-1
EVALUATION_DATABASE_PORT=5432
EVALUATION_DATABASE=event_history
#EVALUATION_DATABASE_CERT_PATH=''
EVALUATION_DATABASE_USER=postgres
EVALUATION_DATABASE_PASSWORD=unused
EVALUATION_DATABASE_HOST=tazama-postgres-1
RAW_HISTORY_DATABASE_PORT=5432
RAW_HISTORY_DATABASE=raw_history
#RAW_HISTORY_DATABASE_CERT_PATH=''
RAW_HISTORY_DATABASE_USER=postgres
RAW_HISTORY_DATABASE_PASSWORD=unused
RAW_HISTORY_DATABASE_HOST=tazama-postgres-1
# REDIS
REDIS_DATABASE=0
REDIS_AUTH=""
REDIS_SERVERS='[{"host":"tazama-valkey-1", "port":6379}]'
REDIS_IS_CLUSTER=false
DISTRIBUTED_CACHETTL=300
DISTRIBUTED_CACHE_ENABLED=true
# EFRUP
ACTIVE_CONDITIONS_ONLY=false
# AUTH
AUTHENTICATED=true
CERT_PATH_PUBLIC=/auth/test-public-key.pem
CORS_POLICY=demo
# TCS LIBRARY DATABASE CONFIGURATION
TCS_DB_HOST=tazama-postgres-1
TCS_DB_PORT=5432
TCS_DB_NAME=tcs
TCS_DB_USER=postgres
TCS_DB_PASSWORD=unused
# KEYCLOAK CONFIGURATION (for fetching approvers)
AUTH_URL=http://keycloak:8080
KEYCLOAK_REALM=tazama
CLIENT_SECRET=auth-lib-client-test-secret
CLIENT_ID=auth-lib-client

# CONNECTION STUDIO (for email notifications)
CONNECTION_STUDIO_URL=http://tazama-cms-backend:3010